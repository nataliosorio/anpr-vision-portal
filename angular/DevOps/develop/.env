# =====================================================
# 🌱 FRONTEND DEVELOP ENV
# =====================================================

ENVIRONMENT=develop

# Puerto host para acceder al frontend
FRONT_PORT=4200

# URL del backend .NET (se comunica por red Docker)
# Opción A: si backend y front están en la misma red Docker
#API_URL=http://anprvision-api-develop:8080/api

# Opción B: si accedes desde fuera del host (Windows, navegador local)
 API_URL=http://localhost:5100/api
